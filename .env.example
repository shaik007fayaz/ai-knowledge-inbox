# Leave OPENAI_API_KEY empty to run fully offline with the deterministic mock provider.
OPENAI_API_KEY=
# auto = openai when a key is set, otherwise mock. Force with: mock | openai
PROVIDER=auto
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
PORT=3001
LOG_LEVEL=info
# Optional: override the similarity threshold (defaults: mock 0.2, openai 0.25)
# MIN_SCORE=0.25
# RATE_LIMIT_MAX=60
